# Copy the fields you need into config/8003.env, config/8004.env, or
# config/8005.env. EnvironmentFile syntax is KEY=value, not shell export.

NINFER_PORT=8003
NINFER_GPU=1
NINFER_PROFILE=fast
NINFER_SERVER=
NINFER_MODEL=
NINFER_API_KEY=change-me
NINFER_MODEL_ID=qwen3.8-27b
NINFER_HOST=0.0.0.0

NINFER_MAX_CONTEXT=262144
NINFER_KV_CAPACITY=1048576
NINFER_MAX_CONCURRENCY=6
NINFER_MAX_PENDING_REQUESTS=16
NINFER_PENDING_TIMEOUT_MS=600000
NINFER_MAX_PRIVATE_CONTINUATIONS=32
NINFER_MAX_SHARED_PREFIXES=12
NINFER_HOST_STATE_SLOTS=16
NINFER_HOST_KV_MIB=16384

NINFER_PREFILL_CHUNK=2048
NINFER_KV_DTYPE=rk4v4-e8
NINFER_DEFAULT_MAX_TOKENS=65536
NINFER_PREFILL_ACTIVATIONS=a16
NINFER_DRAFT_TOKENS=3
NINFER_PROMPT_LOOKUP_TOKENS=15
NINFER_PROMPT_LOOKUP_MIN_MATCH=12

NINFER_VISION=1
NINFER_VISION_MAX_TOKENS=8192
NINFER_CUDA_GRAPH=0

# Optional; leave empty to disable the JSONL request log.
NINFER_REQUEST_LOG=
